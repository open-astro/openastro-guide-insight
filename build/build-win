#!/usr/bin/env bash

usage () {
    cat <<EOF
usage: build-win [OPTIONS]
Options:
  -a arch    build arch: x86|x64 (default: x86)
  -b branch  branch to build (default: current branch)
  -c         cleanup worktree
  -w NAME    use worktree NAME
  -h         display this help

Build installer from current directory
  build-win

Build installer for a specific branch/tag in a worktree
  build-win -b BRANCH -w NAME

Cleanup worktree
  build-win -c -w NAME
EOF
    exit 1
}

arch=x86
do_cleanup=
branch=
use_worktree=

while getopts "a:b:chw:" o; do
    case "${o}" in
        a) arch=$OPTARG ;;
        b) branch=$OPTARG ;;
        c) do_cleanup=1 ;;
        h) usage ;;
        w) use_worktree=$OPTARG ;;
    esac
done
shift $((OPTIND - 1))

case "$arch" in
    x86)
        cmake_arch=Win32
        installer_arch=
        build_dir=tmp
        ;;
    x64)
        cmake_arch=x64
        installer_arch=-x64
        build_dir=tmp64
        ;;
    *) usage ;;
esac

if [[ $do_cleanup ]]; then
     if [[ ! $use_worktree ]]; then
         echo "a worktree is required to cleanup" >&2
         exit 1
     fi
else
    if [[ $use_worktree && ! $branch ]]; then
        echo "a branch is required to use a worktree" >&2
        exit 1
    fi
fi

set -x
set -e

SCRIPT_DIR=$(cd $(dirname "$0"); /bin/pwd)
cd "$SCRIPT_DIR"/..

if [[ $use_worktree ]]; then
    worktree=../$use_worktree
    if [[ $do_cleanup ]]; then
        git worktree remove --force "$worktree"
        exit
    fi
    git fetch -q origin
    git worktree add --force "$worktree" "$branch"
    cd "$worktree"
fi

CMD="/c/Windows/System32/cmd.exe"
CMAKE='/c/Program Files/CMake/bin/cmake.exe'
CTEST='/c/Program Files/CMake/bin/ctest.exe'
ISCC="/c/Program Files (x86)/Inno Setup 5/ISCC.exe"

CMAKE_W=$(cygpath -w "$CMAKE")

V=$(awk '/define +APP_VERSION_STR +/{gsub(/"/,"");print $3}' < <(dos2unix --quiet --to-stdout LogViewFrame.cpp))

INSTALLER=phdlogview${installer_arch}-${V}-installer

if [[ ! $VCPKG_ROOT ]]; then
    echo "VCPKG_ROOT must point at a vcpkg checkout" >&2
    exit 1
fi
case "$arch" in
    x86) triplet=x86-windows-static ;;
    x64) triplet=x64-windows-static ;;
esac
vcpkg_args=("-DCMAKE_TOOLCHAIN_FILE=$(cygpath -w "$VCPKG_ROOT")\scripts\buildsystems\vcpkg.cmake" -DVCPKG_TARGET_TRIPLET=$triplet)

mkdir -p "$build_dir"
cd "$build_dir"

cat >run_cmake.bat <<EOF
"$CMAKE_W" -Wno-dev -A "$cmake_arch" "${vcpkg_args[@]}" -DHAVE_WXFB=0 ..
EOF
"$CMD" /c run_cmake.bat

# generate phd2.iss and README.txt in tmp, one level up from Release/
sed -e "s/@VERSION@/$V/g" ../phdlogview-${arch}.iss.in >phdlogview.iss

"$CMAKE" --build . --config Release

"$CTEST" --build-config Release

"$ISCC" phdlogview.iss /F"${INSTALLER}"
